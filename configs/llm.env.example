# Copy to ~/.config/nnc/llm.env (never commit). Pick one provider.
# Per-vendor file ~/.config/nnc/<name>.env also works (groq.env, openai.env, …).

# NNC_LLM selects the client:
#   heuristic | mock | auto | groq | openai | together | fireworks | openrouter
#   | ollama | gemini | deepseek | mistral | xai | anthropic | perplexity
#   | cerebras | sambanova | nvidia | huggingface | github | deepinfra
#   | novita | moonshot | dashscope | zhipu | cohere | lmstudio | custom
#
# auto = first keyed preset in this order: groq, openai, openrouter, then the
# rest alphabetically. Ollama is not chosen by auto; set NNC_LLM=ollama.
# Groq is one preset. It is not required.
#
# Reasoning models (long chain-of-thought, hosts that reject temperature):
# NNC_LLM_TIMEOUT=180
# NNC_LLM_TEMPERATURE=omit
# NNC_LLM_MAX_TOKENS=4096
# NNC_LLM_MAX_TOKENS_FIELD=max_completion_tokens
# NNC_LLM_JSON_OBJECT=0

# Groq
# NNC_LLM=groq
# GROQ_API_KEY=
# NNC_LLM_MODEL=openai/gpt-oss-20b

# OpenAI
# NNC_LLM=openai
# OPENAI_API_KEY=
# NNC_LLM_MODEL=gpt-4o-mini

# OpenRouter (any routed model id)
# NNC_LLM=openrouter
# OPENROUTER_API_KEY=
# NNC_LLM_MODEL=anthropic/claude-3.5-sonnet

# Local Ollama (no key). LM Studio is NNC_LLM=lmstudio on port 1234.
# NNC_LLM=ollama
# NNC_LLM_MODEL=llama3.2

# Other coded hosts. Leave the value empty until you have a key.
# ANTHROPIC_API_KEY=
# PERPLEXITY_API_KEY=
# CEREBRAS_API_KEY=
# SAMBANOVA_API_KEY=
# NVIDIA_API_KEY=
# HF_TOKEN=
# GITHUB_MODELS_TOKEN=
# DEEPINFRA_API_KEY=
# NOVITA_API_KEY=
# MOONSHOT_API_KEY=
# DASHSCOPE_API_KEY=
# ZHIPU_API_KEY=
# COHERE_API_KEY=

# Any OpenAI-compatible host (vLLM, LM Studio, Azure, lab proxy, …)
# NNC_LLM=custom
# NNC_LLM_BASE_URL=https://host.example/v1
# NNC_LLM_MODEL=your-model-id
# NNC_LLM_API_KEY=
# NNC_LLM_API_KEY_ENV=MY_KEY
# NNC_LLM_JSON_OBJECT=0
# NNC_LLM_TIMEOUT=120
# NNC_LLM_TEMPERATURE=omit
# NNC_LLM_MAX_TOKENS=4096
# NNC_LLM_MAX_TOKENS_FIELD=max_tokens
# NNC_LLM_AUTH_HEADER=api-key
# NNC_LLM_AUTH_PREFIX=
