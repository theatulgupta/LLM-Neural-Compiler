{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NNCLlmProposal",
  "type": "object",
  "required": ["strategy", "rationale", "source"],
  "additionalProperties": false,
  "properties": {
    "strategy": {
      "type": "string",
      "enum": ["baseline", "ort_default", "graph_simplify", "graph_fuse", "graph_fuse_ort", "int8_dynamic", "int8_static"]
    },
    "rationale": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 }
  }
}
